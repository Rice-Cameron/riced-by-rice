def apply_hyprlauncher(t):
    conf = Path.home() / ".config" / "hypr" / "hyprlauncher.conf"
    if not conf.exists():
        return
    bg = t['background'].lstrip("#")
    fg = t['foreground'].lstrip("#")
    acc = t['highlight'].lstrip("#")
    sbg = t['selection_bg'].lstrip("#")
    sfg = t['selection_fg'].lstrip("#")
    content = f"""general {{
    background = rgb({bg})
    foreground = rgb({fg})
    accent = rgb({acc})
    selection_background = rgb({sbg})
    selection_foreground = rgb({sfg})
    rounding = 0
}}

ui {{
    window_size = 620 400
}}

finders {{
    desktop_icons = true
    desktop_terminal = kitty
}}
"""
    with open(conf, "w") as f:
        f.write(content)

def apply_mako(t):
    conf = Path.home() / ".config" / "mako" / "config"
    content = f"""# Auto-generated by theme manager: {t['name']}
font=Noto Sans 10
background-color={t['background']}
text-color={t['foreground']}
border-color={t['highlight']}
border-size=2
border-radius=0
progress-color=source {t['accent']}

anchor=top-right
width=360
height=160
margin=38,14,14,14
padding=10
default-timeout=5000
group-by=app-name
icons=1
max-icon-size=32
layer=overlay

[urgency=low]
border-color={t['border']}
default-timeout=3000

[urgency=normal]
border-color={t['highlight']}

[urgency=high]
border-color={t['colors']['red']}
text-color={t['selection_fg']}
default-timeout=0
"""
    with open(conf, "w") as f:
        f.write(content)
    subprocess.run(["makoctl", "reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def apply_wallpaper(t):
    wp = t.get("wallpaper")
    if wp:
        wp_path = os.path.expanduser(wp)
        if os.path.exists(wp_path):
            hyprpaper_conf = Path.home() / ".config" / "hypr" / "hyprpaper.conf"
            content = f"""wallpaper {{
    monitor = DP-1
    path = {wp_path}
    fit_mode = cover
}}

splash = false
"""
            with open(hyprpaper_conf, "w") as f:
                f.write(content)
            subprocess.run(["hyprctl", "hyprpaper", "wallpaper", f"DP-1,{wp_path},cover"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def apply_hyprtoolkit(t):
    conf = Path.home() / ".config" / "hypr" / "hyprtoolkit.conf"
    bg = t['background'].lstrip("#").upper()
    txt = t['foreground'].lstrip("#").upper()
    base = t.get('surface', '#1c2029').lstrip("#").upper()
    alt_base = t.get('selection_bg', t.get('border', '#282e3b')).lstrip("#").upper()
    bright_txt = t.get('colors', {}).get('bright_white', '#e8edf2').lstrip("#").upper()
    link_txt = t.get('url', '#8ab4c8').lstrip("#").upper()
    acc = t.get('highlight', '#88a4c2').lstrip("#").upper()
    acc_sec = t.get('accent', '#6c8aa8').lstrip("#").upper()
    content = f"""accent = 0xFF{acc}
accent_secondary = 0xFF{acc_sec}
background = 0xFF{bg}
text = 0xFF{txt}
base = 0xFF{base}
alternate_base = 0xFF{alt_base}
bright_text = 0xFF{bright_txt}
link_text = 0xFF{link_txt}
rounding_large = 0
rounding_small = 0
font_family = JetBrainsMono Nerd Font
font_family_monospace = JetBrainsMono Nerd Font Mono
font_size = 10
h1_size = 13
h2_size = 12
h3_size = 11
small_font_size = 9
"""
    with open(conf, "w") as f:
        f.write(content)

def apply_hyprlock(t):
    conf = Path.home() / ".config" / "hypr" / "hyprlock.conf"
    wp = t.get("wallpaper")
    wp_path = os.path.expanduser(wp) if wp else None
    if wp_path and os.path.exists(wp_path):
        bg_path = wp_path
    else:
        bg_path = "screenshot"

    bg_color = hex_to_rgba_hypr(t['background'], 'ff')
    outer1 = hex_to_rgba_hypr(t.get("border_active_1", t["highlight"]), "ee")
    outer2 = hex_to_rgba_hypr(t.get("border_active_2", t["accent"]), "ee")
    inner = hex_to_rgba_hypr(t.get('surface_alt', t['background']), "cc")
    check1 = hex_to_rgba_hypr(t["colors"]["green"], "ee")
    check2 = hex_to_rgba_hypr(t["highlight"], "ee")
    fail1 = hex_to_rgba_hypr(t["colors"]["red"], "ee")
    fail2 = hex_to_rgba_hypr(t["colors"]["bright_red"], "ee")
    font_color = hex_to_rgba_hypr(t['foreground'], 'ff')
    time_color = hex_to_rgba_hypr(t['highlight'], 'ff')
    date_color = hex_to_rgba_hypr(t['foreground'], 'ee')
    user_color = hex_to_rgba_hypr(t['accent'], 'ee')
    shadow_color = "rgba(000000cc)"
    placeholder_hex = t["muted"].lstrip("#")
    fail_hex = t["colors"]["red"].lstrip("#")

    content = f"""# Auto-generated by theme manager: {t['name']}
$font = JetBrainsMono Nerd Font

general {{
    hide_cursor = false
    grace = 0
    disable_loading_bar = true
}}

animations {{
    enabled = true
    bezier = linear, 1, 1, 0, 0
    bezier = easeOutQuint, 0.23, 1, 0.32, 1
    animation = fadeIn, 1, 3, easeOutQuint
    animation = fadeOut, 1, 3, linear
    animation = inputFieldDots, 1, 2, linear
}}

background {{
    monitor =
    path = {bg_path}
    color = {bg_color}
    blur_passes = 3
    blur_size = 6
    noise = 0.015
    contrast = 0.9
    brightness = 0.8
    vibrancy = 0.2
    vibrancy_darkness = 0.2
}}

# TIME
label {{
    monitor =
    text = $TIME12
    color = {time_color}
    font_size = 90
    font_family = $font
    position = -50, -40
    halign = right
    valign = top
    shadow_passes = 2
    shadow_size = 4
    shadow_color = {shadow_color}
}}

# DATE
label {{
    monitor =
    text = cmd[update:60000] date +"%A, %d %B %Y"
    color = {date_color}
    font_size = 22
    font_family = $font
    position = -50, -155
    halign = right
    valign = top
    shadow_passes = 1
    shadow_size = 2
    shadow_color = {shadow_color}
}}

# USER GREETING / ICON
label {{
    monitor =
    text =   $USER
    color = {user_color}
    font_size = 18
    font_family = $font
    position = 0, 50
    halign = center
    valign = center
    shadow_passes = 1
    shadow_size = 2
    shadow_color = {shadow_color}
}}

# INPUT FIELD
input-field {{
    monitor =
    size = 280, 48
    outline_thickness = 2
    inner_color = {inner}

    outer_color = {outer1} {outer2} 45deg
    check_color = {check1} {check2} 120deg
    fail_color = {fail1} {fail2} 40deg

    font_color = {font_color}
    fade_on_empty = false
    rounding = 0

    font_family = $font
    placeholder_text = <span foreground="##{placeholder_hex}">Input password...</span>
    fail_text = <span foreground="##{fail_hex}">$FAIL ($ATTEMPTS)</span>

    dots_size = 0.25
    dots_spacing = 0.35
    dots_center = true

    shadow_passes = 2
    shadow_size = 4
    shadow_color = {shadow_color}

    position = 0, -20
    halign = center
    valign = center
}}
"""
    with open(conf, "w") as f:
        f.write(content)

def apply_all():
    t = load_theme()
    print(f"Applying theme: \033[1;36m{t['name']}\033[0m ({t.get('id', 'custom')})")
    write_palette_lua(t)
    apply_hyprland(t)
    apply_kitty(t)
    apply_waybar(t)
    apply_gtk(t)
    apply_qt_kde(t)
    apply_hyprlauncher(t)
    apply_hyprtoolkit(t)
    apply_mako(t)
    apply_wallpaper(t)
    apply_hyprlock(t)
    print("\033[1;32m✓\033[0m Applied theme across Hyprland, Waybar, Kitty, Neovim, Dolphin, GTK, Mako, Hyprlauncher, Hyprtoolkit, and Hyprlock!")

def list_themes():
    current_name = None
    if CURRENT_FILE.exists():
        try:
            with open(CURRENT_FILE) as f:
                current_name = json.load(f).get("name")
        except Exception:
            pass

    print("\033[1mAvailable themes:\033[0m")
    for p in sorted(THEMES_DIR.glob("*.json")):
        try:
            with open(p) as f:
                data = json.load(f)
                name = data.get("name", p.stem)
                is_curr = (name == current_name)
                prefix = "\033[1;32m* " if is_curr else "  "
                suffix = "\033[0m" if is_curr else ""
                print(f"{prefix}{p.stem:20} -> {name}{suffix}")
        except Exception:
            print(f"  {p.stem:20} (invalid)")

def set_theme(name):
    target = THEMES_DIR / f"{name}.json"
    if not target.exists():
        target = THEMES_DIR / name
    if not target.exists():
        sys.exit(f"Error: Theme '{name}' not found in {THEMES_DIR}")
    shutil.copy(target, CURRENT_FILE)
    apply_all()

def edit_theme():
    editor = os.environ.get("EDITOR", "nvim")
    subprocess.run([editor, str(CURRENT_FILE)])
    print("Detected changes in current.json. Reapplying...")
    apply_all()

def main():
    if len(sys.argv) < 2 or sys.argv[1] in ["apply", "reload"]:
        apply_all()
    elif sys.argv[1] in ["list", "ls"]:
        list_themes()
    elif sys.argv[1] in ["set", "use", "switch"]:
        if len(sys.argv) < 3:
            sys.exit("Usage: theme set <theme-name>")
        set_theme(sys.argv[2])
    elif sys.argv[1] in ["edit"]:
        edit_theme()
    elif sys.argv[1] in ["current", "show"]:
        t = load_theme()
        print(f"Current theme: \033[1;36m{t['name']}\033[0m")
        print(f"  Background: {t['background']}")
        print(f"  Foreground: {t['foreground']}")
        print(f"  Accent:     {t['accent']}")
        print(f"  Highlight:  {t['highlight']}")
    else:
        print("""Usage:
  theme [apply]        Apply current theme to all apps
  theme list           List available themes
  theme set <name>     Switch to a theme (e.g. 'theme set winter-solitude')
  theme edit           Open current theme in $EDITOR and reapply on save
  theme current        Show active theme details
""")

if __name__ == "__main__":
    main()
