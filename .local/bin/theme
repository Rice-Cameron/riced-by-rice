#!/usr/bin/env python3
"""
theme - Universal Theme Coordinator for Hyprland, Waybar, Kitty, Neovim, Dolphin, GTK, Mako, etc.
Change your theme in ONE place and apply it everywhere instantly.
"""

import sys
import os
import json
import shutil
import subprocess
from pathlib import Path

CONFIG_DIR = Path.home() / ".config" / "theme"
THEMES_DIR = CONFIG_DIR / "themes"
CURRENT_FILE = CONFIG_DIR / "current.json"
PALETTE_LUA = CONFIG_DIR / "palette.lua"

def hex_to_rgb(hex_code):
    hex_code = hex_code.lstrip("#")
    if len(hex_code) == 3:
        hex_code = "".join(c*2 for c in hex_code)
    return tuple(int(hex_code[i:i+2], 16) for i in (0, 2, 4))

def hex_to_rgb_str(hex_code):
    r, g, b = hex_to_rgb(hex_code)
    return f"{r},{g},{b}"

def hex_to_rgba_hypr(hex_code, alpha="ee"):
    return f"rgba({hex_code.lstrip('#')}{alpha})"

def load_theme():
    if not CURRENT_FILE.exists():
        first = list(THEMES_DIR.glob("*.json"))
        if first:
            shutil.copy(first[0], CURRENT_FILE)
        else:
            sys.exit("Error: No theme files found in ~/.config/theme/themes/")
    with open(CURRENT_FILE, "r") as f:
        return json.load(f)

def write_palette_lua(t):
    with open(PALETTE_LUA, "w") as f:
        f.write("-- Auto-generated by theme manager\nreturn " + json_to_lua(t) + "\n")

def json_to_lua(data, indent=0):
    ind = "  " * indent
    if isinstance(data, dict):
        lines = ["{\n"]
        for k, v in data.items():
            key = k if k.isidentifier() else f'["{k}"]'
            lines.append(f"{ind}  {key} = {json_to_lua(v, indent + 1)},\n")
        lines.append(f"{ind}}}")
        return "".join(lines)
    elif isinstance(data, list):
        items = [f"{json_to_lua(x, indent + 1)}" for x in data]
        return "{ " + ", ".join(items) + " }"
    elif isinstance(data, str):
        return f'"{data}"'
    elif isinstance(data, bool):
        return "true" if data else "false"
    elif data is None:
        return "nil"
    else:
        return str(data)

def apply_hyprland(t):
    hypr_colors = Path.home() / ".config" / "hypr" / "theme_colors.lua"
    b1 = hex_to_rgba_hypr(t.get("border_active_1", t["highlight"]), "ee")
    b2 = hex_to_rgba_hypr(t.get("border_active_2", t["accent"]), "ee")
    inact = hex_to_rgba_hypr(t.get("border_inactive", t["border"]), "cc")
    shadow_rgb = hex_to_rgb(t.get("surface_alt", t["background"]))
    shadow_hex = f"0xee{shadow_rgb[0]:02x}{shadow_rgb[1]:02x}{shadow_rgb[2]:02x}"

    content = f"""-- Auto-generated by theme manager
return {{
  active_border_1 = "{b1}",
  active_border_2 = "{b2}",
  inactive_border = "{inact}",
  shadow_color    = {shadow_hex},
}}
"""
    with open(hypr_colors, "w") as f:
        f.write(content)
    subprocess.run(["hyprctl", "reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def apply_kitty(t):
    kitty_theme = Path.home() / ".config" / "kitty" / "current-theme.conf"
    c = t["colors"]
    content = f"""# Auto-generated by theme manager: {t['name']}
foreground            {t['foreground']}
background            {t['background']}
selection_foreground  {t['selection_fg']}
selection_background  {t['selection_bg']}

cursor                {t['cursor']}
cursor_text_color     {t['cursor_text']}
url_color             {t['url']}

active_border_color   {t['highlight']}
inactive_border_color {t['border_inactive']}
bell_border_color     {c['red']}

wayland_titlebar_color {t['background']}
active_tab_foreground   {t['selection_fg']}
active_tab_background   {t['background']}
inactive_tab_foreground {t['muted']}
inactive_tab_background {t['surface']}
tab_bar_background      {t['background']}

color0 {c['black']}
color8 {c['bright_black']}
color1 {c['red']}
color9 {c['bright_red']}
color2  {c['green']}
color10 {c['bright_green']}
color3  {c['yellow']}
color11 {c['bright_yellow']}
color4  {c['blue']}
color12 {c['bright_blue']}
color5  {c['magenta']}
color13 {c['bright_magenta']}
color6  {c['cyan']}
color14 {c['bright_cyan']}
color7  {c['white']}
color15 {c['bright_white']}
"""
    with open(kitty_theme, "w") as f:
        f.write(content)
    subprocess.run(["killall", "-SIGUSR1", "kitty"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def apply_waybar(t):
    waybar_colors = Path.home() / ".config" / "waybar" / "colors.css"
    content = f"""/* Auto-generated by theme manager: {t['name']} */
@define-color bg {t['background']};
@define-color fg {t['foreground']};
@define-color surface {t['surface']};
@define-color surface_alt {t['surface_alt']};
@define-color surface_card {t.get('surface_card', t['surface'])};
@define-color border {t['border']};
@define-color border_inactive {t['border_inactive']};
@define-color accent {t['accent']};
@define-color highlight {t['highlight']};
@define-color muted {t['muted']};
@define-color red {t['colors']['red']};
@define-color green {t['colors']['green']};
@define-color yellow {t['colors']['yellow']};
@define-color blue {t['colors']['blue']};
@define-color magenta {t['colors']['magenta']};
@define-color cyan {t['colors']['cyan']};
"""
    with open(waybar_colors, "w") as f:
        f.write(content)
    subprocess.run(["killall", "-SIGUSR2", "waybar"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

