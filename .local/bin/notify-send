#!/usr/bin/env python3
import sys
import subprocess

def main():
    args = sys.argv[1:]
    urgency = 1
    timeout = 5000
    icon = ""
    app_name = "System"
    positional = []

    i = 0
    while i < len(args):
        arg = args[i]
        if arg in ("-u", "--urgency") and i + 1 < len(args):
            u_str = args[i + 1].lower()
            if u_str == "low":
                urgency = 0
            elif u_str in ("critical", "high"):
                urgency = 2
            else:
                urgency = 1
            i += 2
        elif arg in ("-t", "--expire-time") and i + 1 < len(args):
            try:
                timeout = int(args[i + 1])
            except ValueError:
                pass
            i += 2
        elif arg in ("-i", "--icon") and i + 1 < len(args):
            icon = args[i + 1]
            i += 2
        elif arg in ("-a", "--app-name") and i + 1 < len(args):
            app_name = args[i + 1]
            i += 2
        elif arg.startswith("-"):
            i += 1
        else:
            positional.append(arg)
            i += 1

    if not positional:
        return

    summary = positional[0]
    body = positional[1] if len(positional) > 1 else ""

    cmd = [
        "gdbus", "call", "--session",
        "--dest", "org.freedesktop.Notifications",
        "--object-path", "/org/freedesktop/Notifications",
        "--method", "org.freedesktop.Notifications.Notify",
        app_name, "0", icon, summary, body, "[]",
        f"{{'urgency': <@y {urgency}>}}", str(timeout)
    ]
    subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

if __name__ == "__main__":
    main()
